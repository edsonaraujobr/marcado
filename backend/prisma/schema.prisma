generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MASCULINO
  FEMININO
}

enum Rating {
  UM
  DOIS
  TRÊS
  QUATRO
  CINCO
}

enum HaircutType {
  NORMAL
  PROMOCAO
  COMBO
}

model User {
  id         String       @id @default(uuid())
  email      String       @unique
  name       String
  cpf        String       @unique
  password   String
  birthDate  DateTime?
  gender     Gender?
  photo      String?
  Scheduling Scheduling[]

  @@map("users")
}

model Barber {
  id         String       @id @default(uuid())
  email      String       @unique
  name       String
  cpf        String       @unique
  password   String
  birthDate  DateTime?
  gender     Gender?
  photo      String?
  rating     Rating?
  Scheduling Scheduling[]
  Haircut    Haircut[]

  @@map("barbers")
}

model Haircut {
  id         String       @id @default(uuid())
  name       String
  price      Decimal
  time       Int
  type       HaircutType

  combo      Combo?    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  comboId String?

  sale   Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId String?


  Scheduling Scheduling[]
  barberId   String
  barber     Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("haircuts")
}

model Scheduling {
  id   String   @id @default(uuid())
  date DateTime

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  barberId  String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  haircutId String
  haircut   Haircut @relation(fields: [haircutId], references: [id], onDelete: Cascade)

  @@map("schedulings")
}

model Combo {
  id        String  @id @default(uuid())
  description      String
  haircuts Haircut[]

  @@map("combos")
}

model Sale {
  id        String  @id @default(uuid())
  description String?
  newPrice  Decimal
  isActive Boolean
  haircuts Haircut[]
  expiresIn DateTime?

  @@map("sales")
}
